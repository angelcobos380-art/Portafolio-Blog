SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base de datos (por defecto SQLite local; en producción usar PostgreSQL)
# DATABASE_URL=sqlite:///./cms.db

# Orígenes permitidos por CORS (lista separada por comas: CMS web + sitios públicos Astro)
CORS_ORIGINS=http://localhost:5173,http://localhost:4321

# Webhook genérico para reconstruir el sitio público al publicar/actualizar/archivar
# (REBUILD_WEBHOOK_URL tiene prioridad; VERCEL_DEPLOY_HOOK se mantiene como respaldo)
# REBUILD_WEBHOOK_URL=
# VERCEL_DEPLOY_HOOK=

# Almacenamiento de archivos media: local | cloudinary
STORAGE_BACKEND=local
MEDIA_LOCAL_DIR=./uploads
MEDIA_BASE_URL=http://localhost:8000/media
MEDIA_MAX_BYTES=10485760

# Solo requeridas si STORAGE_BACKEND=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=cms-media

# Para generar una SECRET_KEY segura:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
