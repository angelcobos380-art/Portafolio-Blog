---
const facts = [
  ['Enfoque', 'Backend y cloud'],
  ['Stack actual', 'JavaScript · Astro · Git'],
  ['En curso', 'AWS Cloud Practitioner · MongoDB Associate Developer'],
  ['Formación', 'Ingeniería en Tecnologías de la Información · UPChiapas'],
  ['Experiencia académica', 'GCI World · Universidad de Tokio'],
];
---

<div class="profile-switcher" aria-label="Perfil profesional">
  <button class="profile-trigger" type="button" data-profile-panel="facts" aria-haspopup="dialog">
    Datos <span aria-hidden="true">↗</span>
  </button>
  <a class="profile-trigger" href="/historia">Historia <span aria-hidden="true">↗</span></a>
</div>

<dialog class="profile-dialog" aria-labelledby="profile-dialog-title">
  <div class="profile-dialog__content">
    <div class="profile-dialog__header">
      <p class="eyebrow" id="profile-dialog-kicker">Perfil</p>
      <button class="dialog-close" type="button" aria-label="Cerrar panel">×</button>
    </div>

    <section data-profile-view="facts">
      <h2 id="profile-dialog-title">Datos, sin rodeos.</h2>
      <dl class="profile-facts">
        {facts.map(([label, value]) => (
          <div><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>
    </section>

  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.profile-dialog');
  const closeButton = document.querySelector<HTMLButtonElement>('.dialog-close');

  function openProfile() {
    dialog?.showModal();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-profile-panel]').forEach((button) => {
    button.addEventListener('click', openProfile);
  });
  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
