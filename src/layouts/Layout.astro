---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Angel Marco Martinez Cobos — Portafolio y blog',
  description = 'Portafolio y blog de Angel Marco: proyectos, aprendizaje y desarrollo backend.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.url);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <aside class="sidebar" aria-label="Navegación principal">
      <a class="brand" href="#inicio" aria-label="Ir al inicio">AM<span>.</span></a>
      <div class="personal-info">
        <p class="eyebrow">Portafolio personal</p>
        <h1>Angel Marco<br />Martinez Cobos</h1>
        <p class="role">Full-stack developer en formación</p>
        <p class="summary">Construyo aplicaciones web con interés en backend, nube y resolver problemas reales.</p>
      </div>
      <nav class="sidebar-nav">
        <a href="#inicio">Inicio</a>
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#blog">Blog</a>
      </nav>
      <p class="availability"><span></span> Construyendo y aprendiendo</p>
    </aside>
    <main class="page-content"><slot /></main>
  </body>
</html>
