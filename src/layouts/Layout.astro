---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Angel Marco Martinez Cobos — Portafolio y blog',
  description = 'Portafolio y blog de Angel Marco: proyectos, aprendizaje y desarrollo backend.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.url);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <title>{title}</title>
  </head>
  <body>
    <aside class="sidebar" aria-label="Navegación principal">
      <a class="brand" href={base} aria-label="Ir al inicio">AM<span>.</span></a>
      
      <div class="personal-info">
        <p class="eyebrow">Portafolio personal</p>
        <h1>Angel Marco<br />Martinez Cobos</h1>
        <p class="role">Backend & Cloud Developer</p>
      </div>

      <nav class="sidebar-nav">
        <a href={`${base}#inicio`}>Inicio</a>
        <a href={`${base}#proyectos`}>Proyectos</a>
        <a href={`${base}#blog`}>Blog</a>
        <a href={`${base}#contacto`}>Contacto</a>
        <a class="history-link" href={`${base}historia`}>Mi historia <span aria-hidden="true">→</span></a>
      </nav>

      <div class="sidebar-social">
        <a href="https://github.com/angelcobos380-art" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
          <span>GitHub</span>
        </a>
        <a href="www.linkedin.com/in/angel-marco-martinez-cobos-b68184432" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          <span>LinkedIn</span>
        </a>
        <a href="mailto:angelcobos380@gmail.com" aria-label="Email">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          <span>Email</span>
        </a>
      </div>
    </aside>
    <main class="page-content"><slot /></main>
  </body>
</html>