---
import Layout from '../../layouts/Layout.astro';
import { getPublicPosts, renderMarkdown } from '../../lib/cms';

export async function getStaticPaths() {
  const posts = await getPublicPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const html = renderMarkdown(post.content);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title={`${post.title} — Angel Marco`} description={post.title}>
  <div class="post-detail">
    <header class="topbar" aria-label="Encabezado">
      <p>Blog / {post.slug}</p>
    </header>

    <article class="post-article">
      <p class="eyebrow">Blog</p>
      <h1>{post.title}</h1>

      {post.tags.length > 0 && (
        <ul class="tags" aria-label="Etiquetas">
          {post.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}

      <div class="post-body" set:html={html} />

      <a class="post-back" href={`${base}#blog`}>← Volver al blog</a>
    </article>
  </div>
</Layout>

<script define:vars={{ slug: post.slug }}>
  const cmsBase = import.meta.env.PUBLIC_CMS_BASE_URL ?? '';
  if (cmsBase) {
    navigator.sendBeacon(`${cmsBase}/public/posts/${slug}/view`);
  }
</script>

<style>
  .post-detail {
    width: min(780px, 100%);
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 5rem) clamp(1.25rem, 5vw, 5rem);
  }

  .post-article h1 {
    max-width: 18ch;
    margin: .6rem 0 1.5rem;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: .98;
    letter-spacing: -.07em;
  }

  .post-body {
    margin-top: 2rem;
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .post-body :global(h2),
  .post-body :global(h3) {
    margin: 2rem 0 .8rem;
    letter-spacing: -.03em;
  }

  .post-body :global(p) {
    margin: 0 0 1.25rem;
    color: var(--muted);
  }

  .post-body :global(a) {
    color: var(--accent);
  }

  .post-body :global(pre) {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(0, 0, 0, .3);
    overflow-x: auto;
  }

  .post-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .9em;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    color: var(--muted);
    padding-left: 1.4rem;
  }

  .post-body :global(blockquote) {
    margin: 0 0 1.25rem;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }

  .post-back {
    display: inline-block;
    margin-top: 2.5rem;
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .post-back:hover {
    text-decoration: underline;
  }
</style>
