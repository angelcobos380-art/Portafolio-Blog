---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    number: '01',
    title: 'Tu primer proyecto',
    description: 'Explica brevemente el problema, tu aportación y lo que aprendiste al construirlo.',
    tags: ['Astro', 'HTML', 'CSS'],
  },
  {
    number: '02',
    title: 'Proyecto en construcción',
    description: 'Un espacio para el siguiente reto que quieras convertir en una solución real.',
    tags: ['JavaScript', 'Git'],
  },
];

const posts = [
  { category: 'Aprendizaje', title: 'Mi camino como desarrollador', date: 'Próximamente' },
  { category: 'Proyectos', title: 'Notas de proyectos y decisiones técnicas', date: 'Próximamente' },
  { category: 'Backend', title: 'Aprendizajes de la semana', date: 'Próximamente' },
];
---

<Layout title="Angel Marco | Portafolio y blog">
  <section id="inicio" class="hero section" aria-labelledby="hero-title">
    <p class="section-kicker">Hola, soy Angel Marco</p>
    <h2 id="hero-title">Construyo en la web,<br /><em>aprendo en público.</em></h2>
    <p class="hero-copy">Soy desarrollador en formación. Comparto proyectos, aprendizajes y el camino real de convertir ideas en soluciones.</p>
    <div class="hero-actions">
      <a class="button" href="#proyectos">Ver proyectos <span aria-hidden="true">↘</span></a>
      <a class="button button--ghost" href="#blog">Leer el blog</a>
    </div>
    <p class="hero-index" aria-hidden="true">01 / 04</p>
  </section>

  <section id="sobre-mi" class="section about" aria-labelledby="about-title">
    <div class="section-heading">
      <p class="section-kicker">Sobre mí</p>
      <h2 id="about-title">Curiosidad, práctica y comunidad.</h2>
      <p>Me estoy formando como desarrollador mientras documento lo que aprendo. Mi enfoque está en backend, nube y crear proyectos que resuelvan problemas reales.</p>
    </div>
    <div class="facts-grid">
      <article><span>01</span><h3>Backend</h3><p>Node.js, APIs y bases de datos como base para aplicaciones útiles.</p></article>
      <article><span>02</span><h3>Cloud</h3><p>Aprendizaje práctico para entender la infraestructura moderna.</p></article>
      <article><span>03</span><h3>Construir en público</h3><p>Notas honestas para aprender, compartir y mejorar con cada proyecto.</p></article>
    </div>
  </section>

  <section id="proyectos" class="section projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <p class="section-kicker">Portafolio seleccionado</p>
      <h2 id="projects-title">Aprendizaje convertido en proyectos.</h2>
    </div>
    <div class="project-list">
      {projects.map((project) => (
        <article class="project-card">
          <span class="project-number">{project.number}</span>
          <div><h3>{project.title}</h3><p>{project.description}</p></div>
          <ul aria-label={`Tecnologías de ${project.title}`}>{project.tags.map((tag) => <li>{tag}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section id="blog" class="section blog-preview" aria-labelledby="blog-title">
    <div class="section-heading section-heading--row">
      <div><p class="section-kicker">Desde el blog</p><h2 id="blog-title">Notas del proceso.</h2></div>
    </div>
    <div class="post-grid">
      {posts.map((post, index) => (
        <article class="post-card">
          <p>{post.category} <span>0{index + 1}</span></p>
          <h3>{post.title}</h3>
          <footer>{post.date}<span aria-hidden="true">↗</span></footer>
        </article>
      ))}
    </div>
  </section>
</Layout>
